# systemd --user сервис (sudo шаардахгүй; linger асаалттай байх ёстой).
# Суулгах: cp deploy/review-agent.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now review-agent
[Unit]
Description=Review Agent (audit report reviewer)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/review-agent
Environment=NODE_ENV=production
Environment=PORT=8443
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/review-agent/deploy/env
ExecStart=/usr/bin/env node server/server.js --lan --port ${PORT}
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
