# deploy/env — systemd сервисийн орчны хувьсагч (deploy/review-agent.service → EnvironmentFile).
# Энэ файлыг deploy/env болгон хуулж утгаа оруулна. deploy/env нь git-д ОРОХГҮЙ.
# PORT=8443
# AR_HOSTS=review.example.mn,<server-ip>   # нэмэлт зөвшөөрөгдөх host нэр / IP
# AR_JOBS_DIR=/srv/review-agent/jobs
# AR_LOGS_DIR=/srv/review-agent/logs
# AR_ARCHIVE_DIR=/srv/review-agent/archive
# AR_FOLLOWUP_DIR=/srv/review-agent/followup
# AR_RECREQ_DIR=/srv/review-agent/recreq
# AR_USERS_FILE=/srv/review-agent/web/users.json
# AR_SMTP_FILE=/srv/review-agent/web/smtp.json
