{
  // F5 — серверийг VS Code дотроос асааж, breakpoint тавьж debug хийнэ
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Сервер (localhost:8080)",
      "program": "${workspaceFolder}/server/server.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Сервер — дотоод сүлжээ (HTTPS:8443)",
      "program": "${workspaceFolder}/server/server.js",
      "args": ["--lan"],
      "console": "integratedTerminal"
    }
  ]
}
